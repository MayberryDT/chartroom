# Local-only storage. Never use an existing live GBrain database here.
CHARTROOM_HOME=.chartroom
CHARTROOM_PORT=3141
CHARTROOM_JEV=on
# Required for Jev ranking and connections. Leave blank for baseline mode.
TYPESAFE_API_KEY=
# Optional: enables OpenAI embeddings; without it retrieval is keyword-only.
OPENAI_API_KEY=
